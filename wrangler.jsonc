{
  "name": "experiencelens",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "experiencelens.ktsapps.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // Non-secret config. Secrets (JWT_SECRET, GOOGLE_PLACES_API_KEY, ...) are Worker secrets: see .hub/launch.json.
  "vars": {
    "ALLOW_REGISTRATION": "false",
    "CORS_ORIGINS": "",
    "SUBREQUEST_BUDGET": "40"
  },
  // Database is auto-provisioned by name on first deploy; the Worker creates its tables on first request.
  "d1_databases": [{ "binding": "DB", "database_name": "experiencelens-db" }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "env": {
    "staging": {
      "name": "experiencelens-staging",
      "build": { "command": "npm run build" },
      "routes": [{ "pattern": "experiencelens-staging.ktsapps.com", "custom_domain": true }],
      "observability": { "enabled": true },
      "vars": {
        "ALLOW_REGISTRATION": "false",
        "CORS_ORIGINS": "",
        "SUBREQUEST_BUDGET": "40"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "experiencelens-staging-db" }],
      "ratelimits": [{ "name": "LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }]
    }
  }
}
